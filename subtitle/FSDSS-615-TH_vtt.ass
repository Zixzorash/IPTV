Dialogue: 0,0:00:10.00,0:00:14.00,Default,,0,0,0,,หนังเอวีซับไทย แจกวาป.com
Dialogue: 0,0:00:14.02,0:00:18.02,Default,,0,0,0,,FSDSS-615 Karen Kaede (Lemon Tanaka)
Dialogue: 0,0:01:03.32,0:01:09.60,Default,,0,0,0,,ทานากะซังนี่ ไม่สนคนอายุน้อยกว่าบ้างหรอครับ
Dialogue: 0,0:01:09.60,0:01:12.32,Default,,0,0,0,,ไม่ซักนิด
Dialogue: 0,0:01:12.32,0:01:15.28,Default,,0,0,0,,ละ..หรอครับ
Dialogue: 0,0:01:26.96,0:01:33.32,Default,,0,0,0,,ทามาโกะ ขอโทษนะพอดีว่าได้เวลาแล้วงั้นฉันขอตัวก่อนนะ
Dialogue: 0,0:01:33.32,0:01:36.44,Default,,0,0,0,,ไวจัง
Dialogue: 0,0:01:36.44,0:01:40.28,Default,,0,0,0,,ถ้างั้นไว้เจอกันที่โรงเรียน
Dialogue: 0,0:01:40.28,0:01:41.92,Default,,0,0,0,,บาย
Dialogue: 0,0:01:51.04,0:01:54.16,Default,,0,0,0,,นี่กลับไวทุกครั้งเลยเนอะ
Dialogue: 0,0:01:54.16,0:01:56.68,Default,,0,0,0,,เอาน่าๆ ดื่มกันๆ
Dialogue: 0,0:01:56.68,0:01:58.36,Default,,0,0,0,,ชนแก้ว
Dialogue: 0,0:02:00.64,0:02:04.32,Default,,0,0,0,,พี่ นี่แฟนฉันชื่อฮิเดกิคุง
Dialogue: 0,0:02:04.32,0:02:06.80,Default,,0,0,0,,อะ.. สวัสดีครับ
Dialogue: 0,0:02:06.80,0:02:11.00,Default,,0,0,0,,แล้วนี่ก็พี่ฉันชื่อว่าเลม่อน
Dialogue: 0,0:02:12.56,0:02:15.04,Default,,0,0,0,,ยินดีที่ได้รู้จัก
Dialogue: 0,0:02:17.28,0:02:20.16,Default,,0,0,0,,ยินดีที่ได้รู้จักครับ
Dialogue: 0,0:02:26.92,0:02:31.48,Default,,0,0,0,,- จิอะกิ ฉันมีงานต้องทำอยู่งั้นขอกลับเข้าห้องก่อนนะ\N- โอเค
Dialogue: 0,0:02:31.48,0:02:33.88,Default,,0,0,0,,ถ้างั้นก็ตามสบายเลยนะ
Dialogue: 0,0:02:33.88,0:02:37.16,Default,,0,0,0,,คะ..ครับ ขอบคุณครับ
Dialogue: 0,0:02:54.76,0:02:57.40,Default,,0,0,0,,หืม มองอะไร
Dialogue: 0,0:02:58.20,0:02:59.93,Default,,0,0,0,,- เป็นไร\N- ปะ..ป่าว
Dialogue: 0,0:02:59.93,0:03:03.52,Default,,0,0,0,,ฮิเดกิคุง นี่ฟังอยู่ไหม
Dialogue: 0,0:03:03.52,0:03:05.68,Default,,0,0,0,,อ๊ะ ขอโทษ\Nว่าอะไรนะ
Dialogue: 0,0:03:05.68,0:03:08.68,Default,,0,0,0,,นี่หรือว่าจะกลัวพี่ฉันหรอ
Dialogue: 0,0:03:08.68,0:03:12.84,Default,,0,0,0,,ปะ..ป่าวๆ ไม่ใช่นะ\Nขอบคุณที่แนะนำให้รู้จักด้วย
Dialogue: 0,0:03:12.84,0:03:15.24,Default,,0,0,0,,อืม ถ้างั้นก็ดี
Dialogue: 0,0:03:23.52,0:03:25.40,Default,,0,0,0,,เดี๋ยววันนี้ไม่ได้
Dialogue: 0,0:03:25.40,0:03:26.44,Default,,0,0,0,,เอ๊ะ ทำไมๆ
Dialogue: 0,0:03:26.44,0:03:29.04,Default,,0,0,0,,ถ้าจูบก็อยากทำกันขึ้นมาพอดีสิ
Dialogue: 0,0:03:29.04,0:03:30.48,Default,,0,0,0,,ถ้างั้นก็ทำซะสิ
Dialogue: 0,0:03:30.48,0:03:33.20,Default,,0,0,0,,ไม่ได้ตอนนี้ฉันเป็นประจำเดือนอยู่
Dialogue: 0,0:03:33.20,0:03:35.76,Default,,0,0,0,,ประจำเดือน
Dialogue: 0,0:03:35.76,0:03:37.04,Default,,0,0,0,,ถึงเมื่อไหร่
Dialogue: 0,0:03:37.04,0:03:40.32,Default,,0,0,0,,เพิ่งมาวันนี้เพราะงั้นคงอีก 10 วันได้ล่ะมั้ง
Dialogue: 0,0:03:40.32,0:03:42.08,Default,,0,0,0,,สิบวัน
Dialogue: 0,0:03:43.44,0:03:45.20,Default,,0,0,0,,ถ้างั้นพ่อกับแม่เธอก็กลับมาพอดีสิ
Dialogue: 0,0:03:45.20,0:03:48.80,Default,,0,0,0,,อืม ก็นั่นแหละ\Nขอโทษนะ
Dialogue: 0,0:03:48.80,0:03:50.92,Default,,0,0,0,,อืม เข้าใจละ
Dialogue: 0,0:03:50.92,0:03:52.92,Default,,0,0,0,,ขอไปห้องน้ำหน่อยนะ
Dialogue: 0,0:04:07.68,0:04:10.24,Default,,0,0,0,,เอ๊ะ อะไร
Dialogue: 0,0:04:18.80,0:04:22.08,Default,,0,0,0,,มะ..มาทำอะไรอยู่ตรงที่แบบนี้หรอครับ
Dialogue: 0,0:04:22.92,0:04:25.04,Default,,0,0,0,,มานี่ซิ
Dialogue: 0,0:04:25.56,0:04:27.92,Default,,0,0,0,,คะ..ครับ
Dialogue: 0,0:04:38.72,0:04:41.92,Default,,0,0,0,,แต่นี่ทำอะไรอยู่หรอครับ
Dialogue: 0,0:04:41.92,0:04:44.56,Default,,0,0,0,,น่าเสียดายจังเลยเนอะ
Dialogue: 0,0:04:45.84,0:04:48.72,Default,,0,0,0,,ระ..เรื่องอะไร
Dialogue: 0,0:04:48.72,0:04:51.48,Default,,0,0,0,,ที่ไม่ได้จูบกับน้องฉัน
Dialogue: 0,0:04:51.48,0:04:54.20,Default,,0,0,0,,เอ๊ะ เรื่องนั้น...
Dialogue: 0,0:04:57.24,0:05:00.00,Default,,0,0,0,,แต่นี่ปกติก็ทำอะไรแบบนี้ด้วยหรอครับ
Dialogue: 0,0:05:00.00,0:05:02.80,Default,,0,0,0,,จะไปทำได้ไงล่ะ
Dialogue: 0,0:05:02.80,0:05:07.20,Default,,0,0,0,,ที่สำคัญกว่านั้น\Nดูเหมือนว่าอยากจะจูบสุดๆ เลยนี่เนอะ
Dialogue: 0,0:05:07.20,0:05:09.84,Default,,0,0,0,,เรื่องนั้นมันก็...
Dialogue: 0,0:05:09.84,0:05:14.44,Default,,0,0,0,,กะ..ก็อยากอยู่หรอ แต่ว่าเป็นประจำเดือนอยู่ด้วย...
Dialogue: 0,0:05:16.00,0:05:18.72,Default,,0,0,0,,ดีมาก
Dialogue: 0,0:08:14.84,0:08:21.56,Default,,0,0,0,,พี่ครับ ถ้าทำไปมากกว่านี้ล่ะก็ผม...
Dialogue: 0,0:08:21.56,0:08:25.92,Default,,0,0,0,,ไม่ได้หรอ\Nแต่ว่าฉันยังอยากทำอีกจัง
Dialogue: 0,0:09:12.00,0:09:13.80,Default,,0,0,0,,ฮิเดกิคุง
Dialogue: 0,0:09:13.80,0:09:16.60,Default,,0,0,0,,เอ๊ะ ฮิเดกิคุงไปไหนแล้วเนี่ย
Dialogue: 0,0:09:18.04,0:09:20.84,Default,,0,0,0,,เงียบๆ ไว้
Dialogue: 0,0:09:40.96,0:09:45.80,Default,,0,0,0,,เดี๋ยวพี่จะช่วยจูบแบบเข้มข้นให้ยิ่งกว่านี้เอง
Dialogue: 0,0:10:21.28,0:10:26.40,Default,,0,0,0,,ดูสิ\Nตรงนั้นๆ
Dialogue: 0,0:10:28.12,0:10:33.52,Default,,0,0,0,,ไม่ได้นะครับ เดี๋ยวผมจะ...
Dialogue: 0,0:10:45.76,0:10:51.68,Default,,0,0,0,,เอ๊ะ ฮิเดกิคุงไม่ยอมกลับมาซักทีแหะ กระเป๋าก็อยู่นี่แท้ๆ
Dialogue: 0,0:11:07.08,0:11:10.48,Default,,0,0,0,,ถ้าความแตกขึ้นมาจะทำไงหรอครับ
Dialogue: 0,0:11:10.48,0:11:13.24,Default,,0,0,0,,ไม่เป็นไรความไม่แตกหรอก
Dialogue: 0,0:11:26.76,0:11:31.40,Default,,0,0,0,,พะ..พอแค่นี้กันเถอะนะครับ
Dialogue: 0,0:11:31.40,0:11:35.52,Default,,0,0,0,,เอ๋ จะพอแล้วหรอ
Dialogue: 0,0:11:45.12,0:11:48.16,Default,,0,0,0,,พี่ยังอยากทำอีกอยู่เลยนะ
Dialogue: 0,0:11:51.00,0:11:55.92,Default,,0,0,0,,แย่สิครับแบบนี้\Nแล้วผมจะบอกกับจิอากิยังไงล่ะเนี่ย
Dialogue: 0,0:11:55.92,0:11:58.28,Default,,0,0,0,,อ๊ะ พี่มีความคิดดีๆ อยู่นะ
Dialogue: 0,0:11:58.28,0:11:59.64,Default,,0,0,0,,อะไรหรอครับ
Dialogue: 0,0:11:59.64,0:12:05.20,Default,,0,0,0,,ก็ลองบอกไปสิว่าจูบอยู่กับพี่ที่ใต้เตียงกัน
Dialogue: 0,0:12:06.20,0:12:10.12,Default,,0,0,0,,พูดอะไรครับเนี่ยผมจะไปพูดยังงั้นได้ไง
Dialogue: 0,0:12:11.76,0:12:13.24,Default,,0,0,0,,ถ้างั้นทำไงดี
Dialogue: 0,0:12:13.24,0:12:16.08,Default,,0,0,0,,จริงๆ เลยครับเนี่ย
Dialogue: 0,0:12:16.08,0:12:19.52,Default,,0,0,0,,เอาน่า ก็พยายามอย่าให้จิอากิจับได้แล้วกันนะ
Dialogue: 0,0:12:20.48,0:12:22.16,Default,,0,0,0,,แล้วเจอกันนะ
Dialogue: 0,0:12:33.88,0:12:36.36,Default,,0,0,0,,กลับมาแล้ว
Dialogue: 0,0:12:54.32,0:12:56.64,Default,,0,0,0,,พี่
Dialogue: 0,0:12:59.60,0:13:01.36,Default,,0,0,0,,เดี๋ยวฉันไปร้านสะดวกซื้อหน่อยนะ
Dialogue: 0,0:13:01.36,0:13:03.08,Default,,0,0,0,,อะ..อืม
Dialogue: 0,0:13:03.08,0:13:06.32,Default,,0,0,0,,- ยินดีต้อนรับกลับนะ\N- กลับมาแล้วจ๊ะ
Dialogue: 0,0:13:21.04,0:13:24.16,Default,,0,0,0,,จูบกับน้องฉันเป็นไงบ้าง
Dialogue: 0,0:13:28.76,0:13:31.36,Default,,0,0,0,,ลองรีวิวมาหน่อยสิ
Dialogue: 0,0:13:33.00,0:13:35.64,Default,,0,0,0,,ดะ..ดะ..ดีครับ
Dialogue: 0,0:13:41.92,0:13:45.48,Default,,0,0,0,,นี่จะหลบมุมไปไหนหรอ
Dialogue: 0,0:13:46.44,0:13:49.40,Default,,0,0,0,,กะ..กะ..ใกล้ไปแล้วนะครับ
Dialogue: 0,0:13:52.24,0:13:55.68,Default,,0,0,0,,นี่ดียังไงบอกหน่อยสิ
Dialogue: 0,0:13:56.72,0:14:01.56,Default,,0,0,0,,ระ..เรื่องนั้น...\Nมะ..มะ..ไม่รู้ครับ
Dialogue: 0,0:14:03.40,0:14:08.92,Default,,0,0,0,,แต่ดูท่าทางจะดีน่าดูเลยเนอะ\Nก็ตรงนี้เล่นแข็งโป๊กซะขนาดนี้เลย
Dialogue: 0,0:14:08.92,0:14:13.00,Default,,0,0,0,,เอ๊ะ ดะ..เดี๋ยว...\Nอันนี้มัน...
Dialogue: 0,0:14:25.04,0:14:29.92,Default,,0,0,0,,นี่ จูบนั้นน่ะ\Nฉันขอกลบไปซะได้ไหม
Dialogue: 0,0:14:30.88,0:14:33.76,Default,,0,0,0,,มะ..หมายถึงยังไงหรอครับ
Dialogue: 0,0:14:40.52,0:14:44.08,Default,,0,0,0,,ทำอะไรครับๆ
Dialogue: 0,0:15:11.48,0:15:15.68,Default,,0,0,0,,ดะ..เดี๋ยวก็กลับมาแล้วนะครับ\Nไม่ได้ๆ
Dialogue: 0,0:15:15.68,0:15:19.36,Default,,0,0,0,,นี่ฉันจูบแย่กว่าน้องฉันอีกหรอ
Dialogue: 0,0:15:19.36,0:15:23.76,Default,,0,0,0,,อะ กะ..ก็ไม่ใช่แบบนั้นนะครับ
Dialogue: 0,0:15:24.76,0:15:27.40,Default,,0,0,0,,ถ้างั้นก็ไม่เห็นเป็นไรเลยนี่
Dialogue: 0,0:15:42.72,0:15:45.44,Default,,0,0,0,,ลืมตาสิ
Dialogue: 0,0:15:45.44,0:15:47.16,Default,,0,0,0,,ครับ
Dialogue: 0,0:15:47.16,0:15:49.28,Default,,0,0,0,,มองมาทางนี้ซิ
Dialogue: 0,0:16:44.96,0:16:48.44,Default,,0,0,0,,นี่ ลืมตาซิ
Dialogue: 0,0:16:48.44,0:16:50.64,Default,,0,0,0,,ครับ
Dialogue: 0,0:17:17.76,0:17:20.68,Default,,0,0,0,,เดี๋ยวจิอากิจะกลับมาเอานะครับ
Dialogue: 0,0:17:21.96,0:17:25.04,Default,,0,0,0,,ถ้าความแตกขึ้นมาจะโดนโกรธเอาไหมนะ
Dialogue: 0,0:17:38.40,0:17:41.68,Default,,0,0,0,,นี่ ทำไมถึงต้องหลับตาด้วยหรอ
Dialogue: 0,0:17:41.68,0:17:45.88,Default,,0,0,0,,ก็พี่เล่น.. จูบกันแบบนั้นนี่นา
Dialogue: 0,0:17:45.88,0:17:47.96,Default,,0,0,0,,มองมาทางนี้สิ
Dialogue: 0,0:18:09.40,0:18:12.84,Default,,0,0,0,,แล้วนี่จูบกับจิอากิยังไงหรอ
Dialogue: 0,0:18:15.20,0:18:18.72,Default,,0,0,0,,เรื่องนั้น..\Nผมพูดไม่ได้หรอกครับ
Dialogue: 0,0:18:18.72,0:18:20.92,Default,,0,0,0,,ทำไมล่ะ
Dialogue: 0,0:19:27.32,0:19:30.24,Default,,0,0,0,,แลบลิ้นออกมาซิ
Dialogue: 0,0:19:37.68,0:19:41.28,Default,,0,0,0,,ถ้าไม่รังเกียจล่ะก็แบบนี้ฉันขอทำเยอะๆ เลยได้ใช่ไหม
Dialogue: 0,0:19:41.28,0:19:43.76,Default,,0,0,0,,แต่ว่า...
Dialogue: 0,0:20:11.92,0:20:14.32,Default,,0,0,0,,เป็นไรหรอ
Dialogue: 0,0:20:29.04,0:20:33.32,Default,,0,0,0,,นี่มีอะไรแข็งๆ มาโดนใหญ่เลยนะเนี่ย
Dialogue: 0,0:21:15.60,0:21:17.32,Default,,0,0,0,,พอใจแล้วใช่ไหมล่ะครับ
Dialogue: 0,0:21:17.32,0:21:20.88,Default,,0,0,0,,ลองทำเหมือนตอนจิอากิหน่อยสิ
Dialogue: 0,0:21:22.88,0:21:25.12,Default,,0,0,0,,ทำแบบไหนหรอ
Dialogue: 0,0:21:25.12,0:21:27.84,Default,,0,0,0,,จะ..จิอากิ...
Dialogue: 0,0:21:28.84,0:21:31.88,Default,,0,0,0,,ลองทำกับพี่ดูซิ
Dialogue: 0,0:21:33.08,0:21:35.44,Default,,0,0,0,,คะ..ครับ
Dialogue: 0,0:21:45.48,0:21:48.28,Default,,0,0,0,,ปกติทำแบบนี้กันหรอ
Dialogue: 0,0:21:48.28,0:21:50.72,Default,,0,0,0,,ครับ
Dialogue: 0,0:21:50.72,0:21:53.68,Default,,0,0,0,,ไม่ทำแรงๆ กว่านี้หรอ
Dialogue: 0,0:21:53.68,0:21:56.48,Default,,0,0,0,,เรื่องนั้น...
Dialogue: 0,0:21:59.68,0:22:05.52,Default,,0,0,0,,ลองทำเหมือนทุกครั้งดูสิ\Nไม่ใช่แค่นี้หรอกใช่ไหม
Dialogue: 0,0:23:23.80,0:23:25.68,Default,,0,0,0,,จะไม่ไหวแล้วครับ
Dialogue: 0,0:23:25.68,0:23:30.20,Default,,0,0,0,,อะไรหรอ\Nอะไรที่จะไม่ไหวแล้วหรอ
Dialogue: 0,0:23:34.16,0:23:38.96,Default,,0,0,0,,นี่ ตรงไหนจะไม่ไหวแล้วหรอ
Dialogue: 0,0:23:53.88,0:23:58.68,Default,,0,0,0,,นี่ มีอะไรแข็งมาโดนตลอดเลยนะเนี่ย
Dialogue: 0,0:24:10.28,0:24:13.60,Default,,0,0,0,,เลียลิ้นฉันให้ด้วยซิ
Dialogue: 0,0:24:23.52,0:24:27.16,Default,,0,0,0,,เลียเยอะๆ เลย
Dialogue: 0,0:25:02.12,0:25:05.88,Default,,0,0,0,,เป็นไรหรอเมื่อกี้ยังไม่อยากอยู่เลยแท้ๆ
Dialogue: 0,0:25:05.88,0:25:10.48,Default,,0,0,0,,มะ..ไม่..\Nไม่ใช่แบบนั้นนะครับ
Dialogue: 0,0:25:11.76,0:25:17.04,Default,,0,0,0,,มีอารมณ์แล้วนี่เอง\Nกับพี่สาวของแฟน
Dialogue: 0,0:25:57.72,0:26:01.28,Default,,0,0,0,,จิอากิเลียที่แบบนี้ให้ไหม
Dialogue: 0,0:26:01.28,0:26:04.12,Default,,0,0,0,,มะ..ไม่เลียครับ
Dialogue: 0,0:26:45.52,0:26:50.80,Default,,0,0,0,,ถ้าจูบไปด้วยแล้วจับตรงนี้ไปด้วยนี่จะเป็นไงกันเนอะ
